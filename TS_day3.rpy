label TS_day3_morning:
    $ day_time()
    $ persistent.sprite_time = "day"
    $ save_name = ('Лагерь. День третий')
    play music music_list["eat_some_trouble"] fadein 2
    scene int_extra_house_dayy with dissolve

    show uv sport_smile at center with dissolve
    window show
    uv "Доброе утро, братик."

    gg "Доброе утро, сестричка."

    uv "Как ты поспал? Что тебе приснилось?"

    gg "Издеваешься?"

    show uv sport_laugh with dspr
    uv "Немного. Я тоже скучаю по снам."

    gg "Да? И какой твой любимый сон?"

    show uv sport_smile with dspr
    uv "Да уж не про стиральную машину…"

    gg "Так я и поверил. {w}Все котики любят смотреть, как она вращается."

    show uv sport_smile with dspr
    gg "Ты улыбаешься."

    uv "Да. А что?"

    gg "Я думал, что ты обидишься на шутку про котиков. {w}Мол, каждый котик — уникальный и неповторимый."

    show uv sport_angry with dspr
    uv "Точно! Ну готовься к экзекуции."

    show uv sport_smile with dspr
    "Юля прыгнула на меня, выставив руки вперёд."

    "Но вместо атаки стала меня щекотать."

    gg "Ай! Не надо, хвостатая…."

    uv "Надо, бесхвостый! {w}Будешь знать, как маленьких обижать!"

    gg "Я тоже могу щекотать."

    show uv sport_laugh with dspr
    uv "Ай! Ты чего?"

    gg "Так выглядит возмездие!"

    uv "Караул! Котиков обижают!"

    play ambient "knock.ogg"

    show uv sport_smile with dspr
    uv "Кто там?"

    voice "сл"
    sl "Ау! Мухины, вы там проснулись?"

    gg "Славя?"

    sl "К вам можно?"

    gg "Да."

    play music music_list["went_fishing_caught_a_girl"] fadein 2

    show sl sport smile at right with dissolve
    sl "Доброе утро."

    uv "И тебе, и тебе…{w} Спасибо, что пришла. А то меня Максим совсем замучил."

    sl "Неужели храпел?"

    uv "Хуже! Он щекотался."

    gg "Эй! Ты первая начала."

    show sl sport laugh with dspr
    sl "Мои братья тоже все щекотки боятся."

    uv "Я слышала, что те, кто щекотки боится — ревнивые."

    gg "Глупости. Это нормальная защитная реакция организма."

    show sl sport smile with dspr
    sl "Ну что, готовы к пробежке?"

    gg "К чему?"

    uv "К пробежке, Макси. {w}Ты что, уже забыл? Мы же вчера договаривались."

    gg "Да-да… что-то такое было."

    uv "Ну вот. {w}Побежали скорей. {w}Давай наперегонки. Кто последний, тот отдаст свой завтрак."

    gg "Ну так я не согласен."

    uv "М-м-м…{w} ладно. {w}Половину завтрака."

    gg "А может просто побежим?"

    uv "Ну уж нет! Тебе нужен хороший стимул."

    gg "Почему обязательно такой жестокий. Хватило бы и фофана."

    show sl shy sport with dspr
    sl "Можно и по-другому мотивировать.{w} Давайте так: если Макс прибежит первым, то я соглашусь с ним сегодня потанцевать. Идёт?"

    show uv sport_smile with dspr
    uv "Я согласна!"

    show sl sport smile  with dspr
    sl "Отлично! Тогда побежали."

    gg "А меня спросить?"

    scene ext_house_of_ggs_day with dissolve

    show sl sport normal at right with dissolve
    sl "Юля, не торопись, надо сперва разминку сделать."

    show uv sport_smile at left with dissolve
    uv "Ну ладно. А как?"

    sl "Просто повторяйте за мной. Это легко и быстро."

    "Как выяснилось, не так уж и быстро. И не так легко."

    "Славя так ловко махала руками, что я едва за ней поспевал."

    "А уж растягиваться так, как это делала она, у меня и вовсе не получалось."

    "В общем, я успел вымотаться ещё до начала забега."

    play music music_list["always_ready"] fadein 2

    hide sl
    hide uv
    scene ext_path_day with dissolve
    "Так что как только девушки стартанули, я сразу занял позорное последнее место."

    "Славя, разумеется, была первой."

    "А Юля то догоняла Cлавю, то снижала скорость, чтобы поравняться со мной. И сделать пару ехидных замечаний."

    "Возможно, она таким образом пыталась спровоцировать меня на более интенсивную работу ногами, но выходило — не очень."

    "Поэтому она сменила подход."

    show bg ext_path2_day with dissolve
    show uv sport_smile at left with dissolve
    uv "Макси, если хочешь, я Славе поставлю подножку и тогда ты вырвешься вперёд."

    gg "Не надо."

    uv "Ты что, не хочешь с ней потанцевать?"

    gg "Если она неудачно упадёт после твоей подножки, то вообще не сможет танцевать. А тебя — накажут."

    uv "Кто ж меня накажет?"

    gg "Я."

    uv "Хех… чтобы меня наказать, надо сперва меня догнать. А ты — того и гляди на землю рухнешь от усталости."

    gg "Юля, я весь день провёл в теле качка. Я буквально чувствую, насколько я сейчас — слабый."

    show uv sport_laugh
    uv "Ха-ха…{w} А я весь день провела, вылизывая собственный хвост. Так что, ещё вопрос, кому из нас сложнее адаптироваться."

    gg "Ты хотя бы на четвереньках не бежишь."

    uv "Я даже на четвереньках тебя обгоню."

    "Юля не шутила."

    "Она действительно встала на четвереньки и забавно подпрыгивая побежала."

    "Я не удержался от смеха."

    show bg ext_path_day with dissolve
    show sl sport laugh at right
    "Вскоре ко мне присоединилась Славя."

    sl "Максим, а что это с ней?"

    gg "Не знаю. Может, мышку увидела и поймать хочет."

    sl "За…{w} за…{w} ой не могу!{w} Зачем?"

    gg "За хвост повесит на верёвочку. Будет Ульянку пугать. Чтобы конфеты не воровала."

    sl "Так она не боится мышей!"

    gg "Юль, ты слышала? Малая не боится мышей. Придётся споймать зверя покрупнее."

    show uv sport_smile at left
    uv "Я не охочусь. Просто бегать весело."

    sl "А почему на четвереньках?"

    uv "Почему бы и нет? Разве есть закон, который запрещает так передвигаться? Я могу и боком бежать, и задом наперёд."

    show sl sport smile
    sl "Юль, я рада, что тебе весело, но смысл пробежек в тренировке выносливости. Тренировке сердца и дыхания. Если постоянно дурачиться, то будет мало толку."

    uv "Да нам бы всё равно пришлось остановиться. Вон, посмотри на Максика. Он уже еле дышит."

    gg "Да не… я… в порядке. Просто… смешно. Очень."

    sl "Ну ладно, сделаем небольшой перерыв. Возле того озера."

    uv "Какого озера? Я ничего не вижу. Дурацкие чело… глаза! Дурацкие глаза."

    sl "Скоро будет видно. Оно совсем близко. За поворотом."

    hide сл
    hide uv

    "То, что для слави было 'совсем близко', оказалось метрах в трёхста."

    "Я приковылял туда последним."

    play music music_list["get_to_know_me_better"] fadein 2
    scene bg ext_lake_day with dissolve

    show uv sport_smile at left
    show sl sport laugh at right

    sl "Ну что, Максик? Сколько тебе надо для отдыха?"

    gg "Две недели. Обычный отпуск."

    sl "Две недели не дам. А вот три минуты — в твоём распоряжении."

    uv "Здорово, братик. Успеешь и окунуться, и попить водички."

    gg "А утопиться не успею?"

    show uv sport_laugh
    uv "Не… для этого надо минут десять."

    sl "И мы так просто не дадим тебе улизнуть."

    uv "Ага. Пойдёшь топиться — вытащим и откачаем. Славя, ты же умеешь делать искусственное дыхание."

    show sl sport shy
    sl "Нет! То есть, да. Но до этого же не дойдёт. Правда ведь, Максим?"

    gg "Да, конечно. Я просто… пошутил."

    th "Что это с ней?"

    th "Если бы я умел делать искусственное дыхание или какой-нибудь массаж сердца, то гордился бы этим."

    th "Хотя, кто знает? Может, для нынешнего времени это — не такая уж и редкость. Штудируют на уроках гражданской обороны."

    th "А мы даже противогаз не умеем правильно надевать."

    "Я наклонился над озером, чтобы умыться и попить водички."

    gg "У-у-уф… холодная."

    show sl sport normal
    sl "Тут подземный источник. Но к вечеру она теплеет."

    uv "Ты что? И по вечерам бегаешь?"

    show sl sport shy
    sl "Иногда. Только это — секрет. Обещай, никому не рассказывать."

    uv "Ладно. Рот — на замок. Ключ — в огород. И Макси будет молчать."

    gg "Да-да… я тоже. Му, Мухины — не стукачи."

    sl "Вы не подумайте, это не запрещено. Просто… ну…{w} как бы…{w} не поощряется.{w} Вот."
    th "Нашла чего бояться."
    uv "Ну что? Побежали?{w} Догоняйте, дылды."

    hide uv with dissolve

    show sl sport normal
    sl "Дадим твоей сестричке фору?"

    gg "Не…{w} она тогда обидится, что мы поддались."

    play music music_list["what_do_you_think_of_me"] fadein 2

    show sl sport smile
    sl "Вот и я так подумала. Давай! Я тебе помогу…"

    "Славя протянула руку и помогла мне подняться."

    scene ext_path_day with dissolve

    "И мы побежали, не разжимая ладони."

    "Возможно, моя и тем более Славина скорость была выше, двигайся мы нормально. По одиночке."

    "Но в тот момент мне меньше всего хотелось разжимать руку."

    "Я даже не чувствовал усталости. Все обработчики моих рецепторов сосредоточились на ладони."

    th "Так странно. Простое касание, а столько эмоций…"

    scene ext_camp_entrance_day with dissolve

    show uv sport_smile at left with dissolve
    uv "Я решила пересечь финиш прыгая задом наперёд. Так моя победа будет ещё триумфальней."

    "Выглядит так, словно Юля сама решила нам поддаться."

    th "Нам?"

    th "Я успел так привыкнуть к руке, что уже воспринимал себя и Славю как команду?"

    show sl sport smile at right
    sl "Это мы ещё посмотрим!"
    "Мы с лёгкостью догнали валяющую дурака Юлю и приблизились к воротам."
    "Когда до условного финиша оставалось не больше двух метров…."
    window hide
    menu:
        "Пропустить Юлю":
            $ lp_sl +=1
            $ lp_uv +=1
            $ day3_run = 0
            jump TS_skip_yulia
        "Пройти первым":
            $ day3_run = 1
            jump TS_run_first
        "Пропустить Cлавю":
            $ lp_sl +=1
            $ day3_run = 2
            jump TS_skip_slavya

    label TS_skip_yulia:
        window show
        "Я остановился."
        "И остановил Славю. Или она сама остановилась?"
        "В любом случае, мы позволили маленькой попрыгушке победить."
        show uv sport_smile with dspr
        uv "Уверенная победа хвоста…. девчонок. Девчонки в моём лице доказали всему миру, что мы быстрее!"
        sl "Молодец Юля! Ты отлично бежала."
        uv " Ага. Извини, Макси. Но похоже, ты остался без танца."
        show sl shy sport with dspr
        sl " Совсем не обязательно… я… мы… могли…"
        uv "Нет-нет! Уговор есть уговор"
        show sl sad sport with dspr
        sl "Это же просто стимул был, Юль."
        uv "Вот именно! Нечего его поощрять просто так. Вот постарается- тогда и получит танец с красоткой."
        jump TS_day3_day

    label TS_run_first:
        window show
        "Я сделал два больших прыжка, опередив девушек."
        show uv sport_smile with dspr
        uv "Вот это да! Макси так сильно хотел с тобой потанцевать, что чуть штаны не порвал."
        gg "Шорты."
        uv "Не важно. Лучше радуйся, что растяжение не получил."
        "Ну да."
        "Тут нет мамашки-фитоняшки, которая всё ощупает."
        "Только мамашка-стесняшка, которая если начнёт щупать, то умрёт от стыда."
        uv "У-у-ух… завидую я тебе, Славя. Такая красотка, что парни ради танца с тобой, готов здоровьем рисковать."
        jump TS_day3_day

    label TS_skip_slavya:
        window show
        "Я остановился."
        "Но не остановил славю."
        "Даже слегка подтолкнул и она пол шага опередила мою ''сестричку''."
        show uv sport_smile with dspr
        uv "Уверенная победа девчонок. Девчонки в твоём лице доказали всему миру, что мы быстрее! Ура!"
        sl "Спасибо, Юль. Ты тоже отлично бежала."
        uv "Ага. Извини, Макси. Но похоже, ты остался без танца."
        show sl shy sport with dspr
        sl "Совсем не обязательно… мы… я… могла…"
        uv "Уговор есть уговор. Хотя раз уж ты победила, то…"
        sl "Да?"
        uv "Ну короче сама решай."
        show sl smile sport with dspr
        sl "Ну тогда… я за."
        uv "Видал, Макси. Какая Славя великодушная. Не часто встретишь такое качество у красотки."
        jump TS_day3_day

    label TS_day3_day:
        show sl shy sport with dspr
        sl "Скажешь тоже. Ничего я не красотка."
        uv "Ещё какая! Всегда мечтала у меня будет такая же фигура. И такие же длинные косы."
        show sl smile2 sport with dspr
        sl "Хочешь, мы и тебе косички заплетём?"
        uv "Нет! Я… мне… нельзя. Да и волосы у меня не такие густые. Как у тебя."
        uv "Давай лучше тебе заплетём."
        show sl surprise sport with dspr
        sl "Мне? Зачем? Они же и так заплетены."
        show uv sport_laugh with dspr
        uv "А мы расплетём и по новой заплетём. Ещё красивше будет."
        show sl normal sport with dspr
        sl "Ох, Юль. Ну разве что после завтрака… хотя нет. Я же на пляже буду с малышами. А потом в библиотеке. До самого обеда. А после обеда площадь украшать… Дел сегодня невпроворот."
        show uv sport_smile with dspr
        uv "Так я помогу! И Макс поможет. Правда ведь, Макси?"
        gg "А? Что? Почему?"
        uv "Видишь. Мы, втроём, всё быстро украсим и останется кучу времени заплести тебе косички."
        show sl smile sport with dspr
        sl "Я согласна!"
        "Какого чёрта!?"
        "Меня снова без спроса запрягли на какую-то бодягу…"
        "Пожалуй, надо повнимательнее относиться к тому, что происходит вокруг."
        "А то в следующих раз очнусь, а у меня уже почки нет."
        uv "Вот и договорились. Пошли домой, Макси. Хочешь наперегонки?"
        gg "Спасибо, я уже набегался."
        "На неделю вперёд."
        sl "А вы что, мыться не пойдёте?"
        uv "Я - точно нет."
        gg "Гм… ну я бы сходил, если често."
        uv "Ну так иди. Справишься там без меня?"
        gg "Угу. Постараюсь."
        sl "Чуть что - попроси Славю помочь."
        show sl shy sport with dspr
        sl "Ты шутишь?"
        uv "Конечно шучу. Макси сам моется. Аж с 15 лет."
        show sl laugh sport with dspr
        sl "Ну тогда ладно. Встретимся в столовой. Пошли, Максим."
        hide uv sport_smile with easeoutleft
        stop music fadeout 1
        "Славя взяла меня за руку и повела в сторону душевых."
        play music music_list["waltz_of_doubts"] fadein 1
        scene exxt_shower_day with dissolve
        show sl normal sport with dspr
        gg "Мальчики - направо, девочки - налево."
        sl "На этот раз правильно."
        gg "Учусь помаленьку."
        "Мыться сам научился. Отличать лево и право тоже."
        "Готов поступать в первый класс."
        sl "Мы тут встречаемся?"
        gg "Не понял."
        sl "Ну… после душа. Или сразу в столовую пойдём?"
        gg "Давай тут"
        scene int_shower_day with dissolve
        play sound sfx_close_water_sink
        play ambience zvuk_dusha fadein 1
        th "Так странно. Юля ушла, а я не чувствую себя одиноко."
        th "Это потому что другая милая девушка рядом?"
        th "А ведь она мне действительно нравится."
        th "Может даже больше, чем сама Юля."
        th "И мы уже мылись тогда вместе…"
        th "Что если тогда… это была Славя. Таинственная девушка с которой я перестукивался."
        stop music fadeout 1
        "Я постучал два раза."
        play sound stuk_2_raza
        th "И если она ответит, то это значит, что…"
        play sound stuk_dush
        play music music_list["eternal_longing"] fadein 1
        th "Это действительно она."
        th "И теперь она знает, что в прошлый раз это я ей настукивал."
        th "И что теперь делать?"
        "Моя уверенность мгновенно улетучилась."
        th "Флиртовать инкогнито - не то же самое, что флиртовать в открытую."
        sl "Максим? Это ты? У тебя… всё хорошо?"
        gg "Эм-м-м… Да. То есть… шампуня нет. А так всё хорошо. Я могу и… мылом."
        sl "Я сейчас."
        th "Что?"
        th "Она собралась зайти сюда?"
        play sound sfx_close_water_sink
        stop ambience fadeout 1
        "Я выключил воду и схватил полотенце."
        show sl dush_normal with dissolve
        "Еле успел."
        "Ещё бы секунда и…"
        sl "Вот. Можешь взять мой."
        gg "С-с-спасибо…"
        show sl dush_shame with dspr
        sl "А это ты… тогда, после волейбола, стучал?"
        gg "Да… прости, если смутил."
        sl "Нет-нет… {w}было весело. Я сначала подумала на Ульянку. Потом на твою сестру. А сейчас, как услышала…{w} сразу поняла."
        gg "Да. Я тоже не знал, что это была ты. А сейчас понял."
        show sl dush_smile with dspr
        sl "Выходит… ты тогда просто просил шампуня?"
        gg "Не… первый раз случайно стукнул. А потом любопытно стало."
        sl "Ясно. Ну ладно… я тогда пойду."
        gg "Хорошо."
        hide sl with dissolve
        th "Уф-ф-ф…"
        "Сердце бешено колотилось."
        "Я повесил полотенце на ключок."
        show sl dush_smile with dissolve
        sl "Макс, ты только шампунь… "
        th "Чёрт!"
        show sl dush_surp with dspr
        sl "Н-не забудь…"
        show sl dush_shame with dspr
        sl "В-верни… {w} м-можешь потом вернуть."
