label TS_day4_morning:
    $ prolog_time()
    $ persistent.sprite_time = "day"
    $ save_name = ('Сквозь улыбку\nГород. День четвёртый')
    scene kvartura_up
    show uv cat_smile at cat_transform
    hide blink
    show unblink
    window show
    th "Я дома."
    th "Комната та же, что была вчера."
    th "Юля… на месте."
    th "Бицепс - как позавчера."
    stop music
    th "Стоп!"
    th "Почему я голый?"
    th "Неужели мама всё таки стала нудисткой и воспитала меня таким же?!"
    gg "Юля? Ты ничего не хочешь мне сказать?"
    show oxn smile underwear close with dissolve
    nd "Меня вообще-то Оксана зовут."
    play sound sfx_scary_sting
    th "Какого чёрта!"
    oxn "Ты, вроде бы, не много вчера выпил."
    play music Caravan_Palace fadein 2
    gg "Эм-м-м… Я говорил с кошкой."
    show oxn surprise underwear close with dspr
    oxn "Ты назвал кошку Юлей?"
    gg "А что тут такого?"
    oxn "Не знаю. Это же человеческое имя…"
    gg "Как и Васька. Но каждого третьего кота так и называют."
    show oxn smile underwear close with dspr
    oxn "Тоже верно."
    th "Что вообще происходит?"
    th "Почему в моей кровати голая девушка?"
    th "То есть… догадываюсь, почему."
    th "Но.. как?"
    th "Неужели моя жизнь изменилась настолько круто?"
    th "И что мне сейчас делать?"
    th "Я впервые в подобной ситуации."
    th "Мне надо встать и предложить ей кофе? Или лучше завтрак?"
    gg "Хочешь поесть?"
    oxn "Не откажусь."
    gg "Я пожарю яичницу."
    "Я заглянул в спальню."
    "Пусто."
    "Так…"
    scene kitchen_gg with dissolve
    th "Сейчас надо, как-то аккуратно выяснить формат наших отношений."
    th "То есть, если она ошибку с именем так спокойно отреагировала, значит мы недавно познакомились. Возможно, только вчера."
    th "Это - хорошо."
    th "Значит проще будет с ней порвать."
    th "Но вопросов, по-прежнему, много…"
    th "Например, где мама?"
    show oxn normal underwear with dissolve
    oxn "М-м-м… вкусно пахнет. Особый рецепт?"
    gg "Да. Не жалею бекона…."
    show oxn smile underwear with dspr
    oxn "Я запишу."
    gg "Оксан, а я… вчера сильно пьяный был?"
    show oxn normal underwear with dspr
    oxn "Пару пива выпил. Ну и коктейль мой попробовал. А что?"
    gg "Да так… просто пытаюсь вспомнить кое-что."
    show oxn smile underwear with dspr
    oxn "Покормил ли ты кота… кошку?"
    gg "Угу."
    show oxn normal underwear with dspr
    oxn "Ночью, как только пришли. Ты так торопился. Я думала в туалет, а оказалось, что насыпать еды пушистику."
    gg "М-мда… ты уж прости за это."
    show oxn smile underwear with dspr
    oxn "Тебе не за что извиняться. По-моему, это даже мило. Что человек так заботится о братьях наших меньших."
    th "Скорей, о сёстрах наших меньших."
    "Мы с Оксаной позавтракали."
    "И даже разговорились."
    "Но болтали в основном о всякой чепухе. Еда, погода, домашние животные…"
    "Полезной информации я не узнал."
    oxn "Ты в универ поедешь? Я могу до Победы подкинуть."
    gg "Да.. спасибо. Было бы здорово."
    th "Ну вот, хоть что-то… Девушка за рулём."
    th "Значит, как минимум совершеннолетняя."
    play music Frantic_Aerobics fadein 2
    scene black with dissolve
    window hide
    pause(1)
    $ set_mode_nvl()
    nvl show dissolve
    "Пока мы ехали, Оксана почти не говорила."
    "Я тоже помалкивал."
    "Старался привести мысли в порядок и выудить из памяти что-то вменяемое."
    "Старые воспоминания никуда не делись."
    "Но вот новые… были мутными. В памяти всплывала всякая хрень. Вроде названия костей на латыни. Или запоминалки для строения мозга:"
    "Ликвор в третьего нутро,"
    "Сквозь отверстия Монро"
    "Попадает, и не шутки,"
    "Больше чем пол-литра в сутки…"
    "Видимо хорошо помниться только то, что я усердно зубрил."
    nvl hide dissolve
    pause(1)
    $ set_mode_adv()
    scene walk2
    show oxn normal winter
    with dissolve
    window show
    oxn "Ну вот и приехали."
    gg "Супер! Ещё раз спасибо…"
    oxn "Пустяки… Маме что-нибудь передать?"
    play sound sfx_scary_sting
    gg "Маме? Моей?"
    show oxn smile winter with dspr
    oxn "Ну не моей же..."
    "Они знакомы?!"
    gg "Нет… {w}то есть, да. Пусть позвонит… {w}Нам… Нас попросили бланки заполнить. Нужно официальное название её компании."
    show oxn normal winter with dspr
    oxn "Общество с Ограниченной ответственностью \"сибмедцентр\" управляющая компания холдинга \"Ива\"."
    gg "Общество холдинга Ива-центр?"
    show oxn smile winter with dspr#"(спрайт смеющаяся Оксана)"
    oxn "Да просто возьми визитку в бардачке."
    "Я открыл бардачок и обнаружил стопку визиток."
    "Кроме названия компании там было мамино ФИО, телефон и должность:"
    "Начальник психотерапевтического отделения."
    th "А Оксана, получается, её… ассистентка? Или секретарша?"
    oxn "До свидания, Макс."
    gg "И тебе."
    hide oxn with dissolve
    th "Мой безумный план сработал!"
    th "Мама крутая психолог, а я - крутой плейбой."
    th "Кажется…"
    th "Иначе с какой стати красивая, работающая девушка будет мутить с нищим студентом?"
    th "Чтобы подмазаться к начальнице?"
    th "Вряд ли мама такое оценит."
    th "По крайней мере та мама, которую я знаю."
    scene auditor with dissolve
    play music Zacepila fadein 2
    "В универе я был ещё большей звездой, чем я вчерашний."
    "Девушки со мной очень явственно флиртовали."
    "Или так же, как вчера, но я стал наблюдательней."
    "Или они вообще не флиртовали, и это мне просто казалось. Потому что ЧСВ выросло после ночи с красоткой."
    scene kitchen with dissolve
    "Как бы то ни было, в столовую я спустился в большой смешанной компании."
    "Мы весело шутили, болтали и я чуть было не забыл о своей главной цели."
    show al alisa_normal far with dissolve
    th "Какой же использовать подкат?"
    th "Попросить кого-то познакомить? Или разыграть смертельно опасный кашель?"
    th "Или…"
    "В тот момент моя самоуверенность была в районе стратосферы, поэтому я просто подошёл."
    show al alisa_normal with dissolve
    gg "Привет. Мы кажется не знакомы. Но я слышал о тебе столько хорошего, что просто не мог не подойти…"
    show al alisa_angry with dspr
    dv "Ты, блядь, издеваешься?"
    gg "Что?"
    dv "Что слышал, Максим. Отвали от меня!"
    gg "Погоди…{w} так мы{w} уже знакомы?"
    show al alisa_rage with dspr
    dv "То есть ты настолько охуевшее ничтожество, что даже не запомнил меня, да? Зачем утруждаться? Сука, да ты даже подкат поленился изменить."
    gg "Алиса, всё не так…"
    dv "О! Вспомнил всё таки. Свершилось чудо!"
    gg "Дай мне немного времени и я…"
    dv "Я не такая глупая девчонка, которой была два года назад. Мне на уши не присядешь."
    gg "Слушай, тот парень, что бы он там не сделал два года назад…{w} это был не я."
    show al alisa_angry with dspr
    dv "А кто же? Твой брат близнец? Или клон? Или двойник из параллельной вселенной."
    "Последнее, кстати, недалеко от истины."
    gg "Это был…{w} другой я."
    dv "О! Так ты изменился?"
    gg "Всё… сложнее. Алиса, я не знаю, как объяснить. Я не менялся. Но тот парень и я - это разные люди."
    show al alisa_angry with dspr
    dv "Уёбывай! Просто уёбывай! И больше никогда не попадайся мне на глаза."
    gg "Но я же тут учусь и не могу…"
    show al alisa_rage with dspr
    dv "УЁБЫВАЙ!"
    play sound fist_bump1
    with vpunch
    "В меня прилетела тарелка борща."
    "Прямо в лицо."
    "В последний момент я успел отпрянуть и удар пришёл по груди."
    "Всё равно больно."

    "Меня переполняли эмоции, чтобы действовать рационально. Да хотя бы осознанно."
    scene black with dissolve
    "Не знаю, как я покинул столовую?"
    "Может, на автопилоте, как после хорошей пьянки?"
    scene stop_zima with dissolve
    "Как бы то ни было, в себя я пришёл от того, что меня было чертовски холодно. Куртка не сильно помогала. Промокшая кофта давала о себе знать."
    "Судя по табло автобус будет через 13 минут. Пока я дождусь - замерзну нахрен. Надо вызвать такси. А хватит ли денег?"
    "Я порылся в карманах и нащупал только карточку… нет. Визитку."
    "Мамину визитку."
    th "Может, получится у неё переодеться? Или она сама меня подвезёт. Или Оксана…"
    th "Всё одно лучше, чем стоять тут и мёрзнуть."
    play music Through_the_Breach fadein 2
    scene priyomnaya with dissolve
    show oxn surprise dress with dissolve
    oxn "Максим? Что случилось? Ты поранился?"
    gg "Это - не к-кровь. Это т-так…{w} к-кулинарное п-происшествие."
    oxn "Боже! Да ты весь дрожишь… {w}Сделать тебе горячего чаю?"
    gg "Д-да…{w} если не т-трудно"
    oxn "Сейчас."
    hide oxn with easeoutright
    th "Может включить наглость и попросить коньяка?"
    th "Хотя нет…"
    th "Последняя моя наглость мне дорого обошлась."
    show oxn normal dress with easeinright
    oxn "Вот держи."
    gg "Сп-пасибо."
    oxn "Елена скоро освободится."
    gg "Х-хорошо."
    show oxn surprise dress with dspr
    oxn "Так что случилось?"
    gg "П-повздорил… со знакомым."
    th "Ни к чему её знать правду. С другой стороны, я сам толком ничего не знаю.{w} Кроме того, что я…{w} парень, который жил в моём теле, каким-то образом обидел Алису."
    th "Подозреваю, что они встречались, а потом я.. он её бросил. Или изменил."
    show oxn dress normal with dspr
    oxn "И что же вы не поделили? Котлету?"
    gg "Вроде того."
    th "Будь я возраста Ульянки, возможно это и было бы достаточной причиной для конфликта."
    th "Впрочем, я как-то подрался с одноклассником по ещё более идиотскому поводу. Он сказал, что робокоп круче терминатора. Такого кощунства мой восьмилетний разум не смог вынести."
    show oxn smile dress with dspr
    oxn "Наверное твой приятель - очень вспыльчивый."
    gg "Есть такое."
    show oxn dress normal with dspr
    oxn "Аккуратней надо быть с такими. Мог и вилку в глаз воткнуть."
    gg "Учту."
    th "Какая нелепая была бы смерть. Умер за проступок другого парня."
    gg "А у тебя как дела?"
    oxn "Всё хорошо. Поработала, перекусила, снова поработала…{w} Никто на меня борщ не выливал. Хотя у нас тут буйных тоже хватает."
    gg "В следующий раз буду обедать с тобой."
    oxn "Это приглашение на свидание?"
    gg "Что? Нет…{w} то есть…{w} В каком смысле?"
    show oxn smile dress with dspr
    oxn "Да не красней ты так! После того, как мы видели друг друга без одежды, глупо стесняться свиданий."
    gg "Пожалуй."
    show oxn normal dress with dspr
    oxn "И кстати, насчёт одежды…{w} У нас тут как раз есть запасные рубашки."
    th "Тут должна быть шутка про смирительные, но я слишком взвинчен для юмора."
    gg "Если честно, я за этим и пришёл!"
    oxn "Вот значит как? А я думала, чтобы маму навестить. Или потому что по мне соскучился."
    gg "Что?"
    show oxn smile dress with dspr
    oxn "Ещё немного и ты станешь одного цвета со своей кофтой. {w}Вчера ты таким стеснительным не был."
    gg "Ну я просто выпил и…"
    oxn "Не-не...{w} тут дело не в алкоголе. Тут что-то другое."
    "Не прекращая болтать Оксана подошла к шкафу и, порывшись, достала оттуда несколько рубашек."
    oxn "Пьяный и трезвый конечно отличаются. Но ты сегодняшний и вчерашний, это словно два разных человека. Это очень странно."
    th "Странно, что кроме Оксаны этого никто не заметил."
    gg "Не мог же я за ночь так сильно поменяться."
    show oxn normal dress with dspr
    oxn "Пожалуй. Примерь эту."
    "Девушка вручила мне одну из рубашек."
    "Взяв рубашку, я замешкался. Захотелось спросить, где тут туалет, чтобы там спокойно переодеться."
    "Но такой вопрос спровоцировал бы очередную волну ехидных комментариев."
    "Так что я разделся по пояс."
    "И разумеется именно в этот момент вышла мама."
    show le lena_4_sur at right with dissolve
    un "Максим? Что ты тут делаешь? И почему в таком виде?"
    gg "Это… {w}долгая история."
    show oxn smile dress with dspr
    oxn "Да он подрался. Намок. Замёрз. Зашёл переодеться."
    show le lena_4_smile at right with dspr
    un "Бедненький. Досталось тебе."
    gg "Угу. Вы ещё второго парня не видели."
    th "Мне всего лишь одежду попортили, а я разбил ему, то бишь ей, сердце.{w} И себе заодно."
    un "Зайди ко мне всё расскажешь. Оксан, а ты подготовила отчёт?"
    oxn "Уже у вас в принтере."
    un "Тогда можешь идти."
    oxn "Спасибо, Елена Михайловна. Пока, Макси…"
    hide oxn with easeoutright
    scene Kabinet_Lena with dissolve
    show le lena_4_normal with dissolve
    un "Садись, сынок. Рассказывай."
    gg "У тебя тут очень миленько…"
    un "Ты был тут раз двадцать и только сейчас заметил?"
    th "Не на приёме, надеюсь."
    gg "Не знаю… просто заметил. Такое настроение."
    show le lena_4_ser with dspr
    un "Просто так ничего не бывает. Если обычные вещи вызывают новые эмоции, значит изменились не они, а ты сам. И так… {w}кто она?"
    gg "Она?"
    un "Девушка, с которой ты поругался."
    gg "Как ты… с чего ты взяла, что это была она?"
    show le lena_4_smile with dspr
    un "Потому что ни один парень в мире, как бы он ни был зол, не выкинет борщ."
    th "Логично."
    gg "Ты права. Это была девушка. Которая…{w} ну которая мне нравится."
    show le lena_4_normal with dspr
    un "А ты ей?"
    gg "Как выяснилось, нет."
    un "Почему ты не рассказывал о ней? Мы договорились, не держать никаких секретов."
    th "То есть с этой мамой у нас ТАКИЕ отношения?"
    th "Предельно доверительные?"
    gg "Не знаю…{w} как-то к слову не пришлось."
    show le lena_4_ser with dspr
    un "То есть для тебя, это не достаточно серьёзно, чтобы рассказать маме. Но для неё  достаточно серьёзно чтобы запустить в тебя тарелкой с супом."
    gg "Всё…{w} сложно."
    un "Так поделись. Нельзя держать в себе переживания.{w} А то сам знаешь что будет?"
    gg "Что?"
    un "Нервный срыв."
    gg "Эм-м-м…"
    show le lena_4_smile with dspr
    un "Давай, Максим. Мы же не хотим чтобы в газетах писала, что Максим Мухин убил 8 человек и покончил с собой. {w}Что будет с моей репутацией, если узнают, что я проглядела депрессию у родного сына?"
    gg "Не бойся.{w} У меня нет пистолета."
    show le lena_4_ser with dspr
    un "И это единственное, что тебе останавливает?"
    gg "Я просто пошутил…."
    un "Ты прекрасно знаешь, что через остроумие прорывается бессознательное."
    th "Это что получается?"
    th "Все те гейские шуточки с Женькой были проявлением моего голубого подсознания?"
    show le lena_4_normal with dspr
    un "Так что? Будешь рассказывать?"
    gg "Я не знаю с чего начать."
    show le lena_4_smile with dspr
    un "Для начала расскажи, как её зовут."
    gg "Алиса."
    un "Алиса? Хм-м-м…{w} что-то знакомое. Мы с ней знакомы?"
    th "Вот откуда мне знать?"
    th "Два часа назад я даже не знал, что сам с ней знаком."
    gg "Не уверен."
    un "Ладно.{w} И что между вами происходит? Что произошло?"
    gg "Всё… сложно."
    show le lena_4_ser with dspr
    un "Ну конечно сложно. Иначе бы тут не сидел и не пах варённой свёклой. Вы встречались."
    gg "Вроде того."
    show le lena_4_normal with dspr
    un "Но потом расстались. Так?"
    gg "Угу."
    un "Почему?"
    gg "Не знаю."
    un "Кто был инициатором? Или это тоже не знаешь?"
    gg "Ма… я правда не знаю."
    show le lena_4_ser with dspr
    un "Мне кажется, что ты что-то от меня скрываешь. И я не отстану пока ты мне… "
    play sound phone_lena
    pause(3)
    show le lena_4_ser with dspr
    un "… прошу прощения. Да? Да, уже отправили. Нет, не ошиблись. Возможно, какой-то сбой. Я сейчас посмотрю на своей стороне."
    show le lena_4_smile pioneer with dspr
    un "Максим, это надолго. Езжай домой. Вечером всё обсудим."
    gg "Хорошо."
    show priyomnaya with dissolve
    th "Надолго - это насколько?"
    th "На полчаса?"
    th "Успею метнуться в прошлое, чтобы всё исправить?"
    th "Блин…"
    th "Юля же может и отказаться."
    th "И что тогда?"
    th "Буду жить в мире, где Алиса меня ненавидит, а от мамы нет никаких секретов?"
    th "Голова закружилась и я схватился за стенку."
    stop music fadeout 1
    th "Мне нужно прийти в себя. Нужно что-то из моего привычного мира. Что-то родное…"
    scene black with dissolve
    "..."
    window hide
    pause(1)
    scene zhpad with dissolve
    play music zh_theme fadein 1
    show zh angry_close with dissolve
    window show
    mz "Макс, если припёрся пьяным, я с тебя шкуру спущу."
    th "Слава Богу она меня помнит."
    gg "Жень, прости что свалился как снег на голову. Но мне…"
    mz "Что это за запах?"
    gg "Ты о чём? Ах да… это борщ, пролил на себя…"
    th "Странно что он не выветрился по дороге."
    gg "Долгая история."
    mz "Не такая уж и долгая. Ты чё хотел?"
    gg "Поговорить надо."
    "Я продемонстрировал злюке две баночки пива."
    show zh laugh_close with dspr
    mz "Чёрт с тобой. Знаешь, как меня подкупить."
    window hide
    show pollitra with dissolve
    pause(1)
    scene zhkomnata_day with dissolve
    show zh calm_close with dissolve
    window show
    gg ".. И она кинула в меня тарелкой."
    mz "Стоп! Ты подкатил к бабе, которую сам бросил, да ещё и забыл про это?"
    gg "Можно и так сказать…{w} но я в самом деле не помню, чтобы мы были вместе. Ну словно я… с параллельного мира, где между мной и Алисой ничего не было. Никогда. Только в мечтах.{w} Понимаешь?"
    show zh laugh_close with dspr
    mz "Не-а…{w} ты вроде и немного выпил, а язык как будто из жопы."
    gg "Да ладно, я всегда так говорю."
    show zh calm_close with dspr
    mz "Не-е-е…{w} обычно ты заливаешься блядской птицей соловьём. Аж во рту приторно. А теперь:{w} бэк… мэк. {w}Параллельные миры какие-то… {w} Ты давай без метафор. Говори, как есть."
    gg "Если я скажу, как есть, то ты мне не поверишь."
    show zh angry_close with dspr
    mz "Но тогда лучше вообще не говори."
    gg "Но я же именно за этим и пришёл."
    mz "Чушь! Ты опять от мамки прячешься. Разве нет?"
    "Я отвёл взгляд."
    show zh calm_close with dspr
    mz "Что и требовалось доказать."
    gg "Прости…"
    mz "Да забей. Я всё понимаю. Если бы моя маман так лезла в мою личную жизнь, то я бы с дома сбежала.."
    gg "А я часто к тебе…{w} бегал?"
    mz "Сам знаешь."
    gg "Ну я просто не всегда осознавал, когда сбегал, а когда просто приходил к другу. Выпить пива."
    mz "Если просто перекантоваться, то пару раз в неделю. А если с ночёвкой, то…{w} раз в месяц минимум. "
    gg "Охренеть!"
    show zh laugh_close with dspr
    mz "Ага. Вот её Богу, если бы так же разводил маму на деньги, как разводишь меня на ночёвку, то ты бы уже машину себе купил."
    th  "Интересно какую?"
    th "ДеЛориан?"
    gg "Я бы тебя покатал."
    mz "Хе-хе…{w} Помнишь, именно с такой фразой ты подкатывал ко мне яйца. Лет по 14 нам было."
    gg "И за это прости."
    show zh calm_close with dspr
    mz "За это я как раз не обижаюсь. Мне было лестно внимание красавчика. А я ещё тогда впервые серьезно задумалась о своей ориентации."
    gg "Правда?"
    mz "Как и все девочки я часто фантазировала, кто будет ОН. Тот самый. {w}Я всё думала про нас. Даже пыталась нарисовать нас вместе. И в какой-то момент поняла, что больше думаю о себе, чем о тебе. А том, как буду выглядеть я… Понимаешь?"
    gg "Кажется, да."
    mz "Я так много думала и так страстно думала о своей писе, что кончила. А потом ещё раз. И ещё. И на четвёртый раз поняла, что тебя больше нет в моих фантазиях."
    th "Отлично."
    th "Я настолько лишний в этом мире, что мне даже лучшая подруга исключила из фантазий."
    gg "Если тебе станет от этого легче, я несколько раз представлял… как мы… это самое. И довёл всё до логического завершения."
    show zh laugh_close with dspr
    mz "Такое чувство, что нам снова по 12 лет и мы говорим о вещах, о которых ни черта не понимаем."
    gg "А разве существую вещи, о которых мы хоть что-то понимаем?"
    show zh calm_close with dspr
    mz "Туше…{w} Получается, ничего не поменялось. Что бы мы не делали…"
    th "Может это и ко мне относится?"
    th "Ко мне и Алисе."
    th "Я же побывал в трёх новых версиях, и нигде мы не смогли сойтись. Точнее в этой версии сошлись, но сделали это… так сказать… за кадром."
    th "Недалёт, недалёт, перелёт."
    th "Может в этом и проблема? Я пытался прокачать отдельные навыки и способности, а надо бы прокачиваться целиком. Всё сразу. Чтобы быть гармонично развитым."
    th "Но как внушить это маме?"
    th "А даже если и получится, то нет никаких гарантий, что новая версия меня уже снова заранее испортит отношения с Алисой."
    th "От такого вообще нет страховки. Разве что переехать из Челябы и вернуться аккурат ко вчерашнему дню."
    th "И приду я в столовую такой, подойду к Алисе и скажу: ''Привет, я - новенький. Меня зовут Максим, но все зовут меня Муха. И ты зови. Проведёшь мне экскурсию?''.. И мы возьмёмся за руки и пойдём…"
    mz "О чём задумался?"
    gg "О том, как всё исправить?"
    mz "Любопытно."
    gg "Если бы могла изменить свою жизнь…{w} с самого начала. Что бы ты изменила?"
    show zh laugh_close with dspr
    mz "Это же не возможно!"
    gg "А если бы было возможно?"
    show zh calm_close with dspr
    mz "Хм-м-м…. {w}всё равно ничего. Я - это я. {w}Даже плохие вещи, которые случились, сделали меня… мной."
    gg "А если они мешают тебя достичь чего-то в будущем?"
    mz "Не знаю, Макс.{w} В жизни всё связано. И если изменить что-то одно, то измениться практически всё."
    gg "И не говори."
    mz "Вот допустим, я хотела в восемь лет куклу с набором красивых платьев. {w}Но мама решила вместо этого купить мне конструктор."
    gg "И?"
    mz "Ну вот. {w}И теперь я учусь на строительном. Ненавижу учёбу, и из-за неё всю жизнь. Потому что хочу быть модельером и дизайнером модной одежды.{w} И кажется, что если бы не тот дурацкий конструктор, то так бы оно и было."
    show zh laugh_close with dspr
    mz "И вот я как-то меняю прошлое. Получаю в подарок куклу. И в настоящем я учусь на дизайнера, как мечтала. Но теперь я натуралка."
    gg "Это так плохо?"
    show zh angry_close with dspr
    mz "А ты как себя почувствовал, если бы завтра родился педиком?"
    gg "И то правда."
    mz "Причём проснулся в кровати с незнакомым голым мужиком."
    th "Я даже от незнакомой голой девушки в ахуе был."
    gg "Эффект бабочки."
    show zh calm_close with dspr
    mz "Вроде того. {w} Короче, если что-то работает… лучше это не трогать. Это первое правило инженера-конструктора."
    gg "Я думал, это правило программистов."
    show zh angry_close with dspr
    mz "Второе правило: держать ебальник на замке."
    gg "Намёк понял. Рот - только для пива."
    show zh laugh_close with dspr
    mz "Вот теперь я тебя узнаю"
    gg "Спасибо."
    mz "Так и знала, что Макс, которого я знала, прятался где внутри."
    gg "Жаль, мне уже пора."
    mz "Не боишься, что мама уже вернулась?"
    gg "Наоборот. Боюсь, что её до сих пор нету. А мне… надо Юлю покормить."
    show zh calm_close with dspr
    mz "Понимаю. Погладь её за меня."
    gg "Обязательно."
    stop music fadeout 1
    scene black with dissolve
    "..."
    pause(1)
    scene kvartura_up with dissolve
    show uv cat_smile at cat_transform with dissolve
    gg "Привет. Ты голодная?"
    uv "С чего это такая забота и щедрость?"
    gg "Просто я подумал, что меня и мамы целый день не было дома… и я… Короче, тебя покормить?"
    uv "В лагере поем."
    gg "Стоп! Так уже знаешь, что я…"
    uv "Опять облажался? Да уж догадалась. От тебя пахнет пивом и Женькиными духами."
    gg "А чем должно было бы пахнуть в случае успеха?"
    uv "Кофем. И дофамином."
    th "Дофамином?"
    th "Интересно, а какой у него запах?"
    gg "Понятно."
    uv "Готов к ещё одному вояжу в прошлое?"
    gg "Нет. Но когда это нас останавливало?"
    uv "Хотя бы план у тебя есть?"
    gg "А-а-а…. на месте разберёмся. Не впервой."
    uv "Хе-хе… Макси, у тебя и с планом-то не особо выходило. Уверен, что без плана станет лучше?"
    gg "Буду импровизировать."
    uv "Моё дело - предупредить."
    gg "Я понял, я хочу сказать…."
    uv "Всё! Разговоры потом. Мр-мяу!"
    "Юля прыгнула на меня мир погрузился в темноту."
    scene black with dissolve
    jump TS_day4_lager_morning

label TS_day4_lager_morning:
    scene int_extra_house_dayy
    $ save_name = ('Сквозь улыбку\nГород. День первый')
    $ day_time()
    $ persistent.sprite_time = "day"
    show uv pioneer_laugh
    show unblink
    hide blink
    play music music_list["eat_some_trouble"] fadein 2
    uv "Привет, солнышко! Давно не виделись."
    gg "Такова она, жизнь в Челябинске. Редко видишь солнце, редко видишь улыбки, редко смеёшься сам…"
    show uv pioneer_angry with dspr
    uv "Это ты так начинаешь день? {w}С негатива?{w} Нет чтобы сказать \"Доброе утро, любимая сестричка!\" Я бы ответила: \"Доброе утро, вредный братик.\""
    gg "Это почему это ты \"любимая\", а я - \"вредный\"?"
    show uv pioneer_smile with dspr
    uv "Потому что вредничаешь."
    gg "Я наоборот хотел спасибо сказать.{w} За такой интересный отпуск.{w} Лето посреди зимы.{w} Если бы можно было сюда туры организовывать, то мы бы разбогатели."
    show uv pioneer_normal with dspr
    uv "Ты бы знал, как это сложно делать…"
    scene ext_house_of_ggs_day with dissolve
    gg "Мы будем по миллиону долларов брать."
    show uv pioneer_laugh with dissolve
    uv "Макси, люди, у которых есть такие деньги и так могут путешествовать в лето. Просто в другое полушарие слетал - и ты там."
    gg "Я слышал, что один парень летел вокруг Земли на самолёте со скоростью вращения планеты. Чтобы постоянно видеть закат. Или рассвет. Не помню точно."
    uv "Бесконечный рассвет? Звучит."
    gg "Как название для альтернативной рок-группы."
    scene ext_path_day
    show uv pioneer_smile
    with dissolve
    uv "Так сколоти свою группу. Будете выступать в клубах и барах. Девчонки любят рок-звёзд. Алиса так точно в тебя влюбится."
    gg "Угу. Не это слишком рискованно… Даже моя эмпатичная версия уже умудрилась повстречать с Алисой и бросить. А рок-музыкант сделает это ещё быстрее. И в извращённой форме."
    show uv pioneer_normal with dspr
    uv "В извращённой форме - это как? Наградив напоследок хламидиями?"
    gg "Это собщением в телеге."
    th "А если в Максе - то это уже особо извращённая форма"
    show uv pioneer_laugh with dspr
    uv "Могло быть и хуже. Он мог написать напоследок песню, где выставит её в неприглядном свете. И песня станет хитом."
    gg "Своего рода бессмертие."
    uv "Угу. Отношений уже нет. Может даже, человека уже нет.{w} Но весь мир помнит, что какая-то баба по имени Элис - шлюха."
    th "Элис? Ху зе фак из Элис?"
    show uv pioneer_smile with dspr
    uv "Пошли, Макси, умываться. Если повезёт, то встретим твою маму. Объясним ей кое-что."
    gg "Про важность гигиены?"
    show uv pioneer_normal with dspr
    uv "Нет, дурачок! Объясним ей что важно поддерживать хорошие отношения со своими бывшими."
    th "Угу. На случай, если в твоё тело вдруг внедриться гость из параллельного мира и захочет возобновить отношения."
    gg "Слушай, а может меня надо было просто переместить в тот мир, где я уже в отношениях с Алисой. Такой же есть?"
    show uv pioneer_smile with dspr
    uv "Нет, Макси. ты будешь первым."
    gg "Зашибись…{w} Стой! А мое же место никто не займёт после успеха?{w} Не хочется так напрягаться ради кого-то левого."
    uv "Во-первых, не левого. А такого же, или почти такого же Максима.{w} А во-вторых, не больно ты и напрягаешься."
    gg "Я позавчера бегал, между прочим. И умываюсь холодной водой."
    uv "Угу. А вчера ещё и чуть не погиб в неравной схватке с тарелкой борща."
    gg "Эй! Это было больно. Разве не тянет на подвиг?"
    uv "Ну Один бы за такую битву тебя в Вальхаллу не принял."
    th "Вот блин!"
    th "Придёт вернуться к старому плану: напасть на сиделку со скальпелем в руках. {w}Лет в 80. Ну или до скольки я там протяну…"
    scene ext_washstand_day
    play music music_list["i_want_to_play"] fadein 2
    show uv pioneer_laugh at left
    show us smile sport at right
    with dissolve
    us "А вот и мои детки! Как вам спалось, малыши?"
    uv "Доброе утро, мамочка.{w} Мне ничего не снилось. А вот Максику приснился кошмар и он описался."
    show us laugh sport with dspr
    uv "Надо поменять ему трусики."
    show us dontlike sport with dspr
    us "Фу-у-у… {w}не хочу трогать его испачканное бельё. Пусть так и ходит весь день."
    uv "Это ж вредно. А мамы должны заботиться о своих детках. Следить, чтобы они были чистыми.{w} Вылизывать… {w}в смысле умывать. Чтобы кушали, пили, спали…"
    th "И рассказывали о своей личной жизни, ага."
    show us smile sport with dspr
    us "Всё. Решено не буду заводить детей. Мальчиков - так точно. Только девочек."
    show uv pioneer_smile with dspr
    uv "Но то же не можешь выбрать пол ребёнка. Кто родится - то родится."
    show us smile sport with dspr
    us "А я это… {w}на УЗИ посмотрю, кто будет. И если мальчик, то сделаю аборт."
    th "Жёстко."
    th "В Китае, кажется, что-то такое практиковали. Только наоборот. Избавлялись от девочек."
    show uv pioneer_normal with dspr
    uv "Ульян, если можно различить пол, то там уже такой срок, что нельзя делать аборт."
    show us dontlike sport with dspr
    us "Блин! А план был хорош. Ладно… "
    show us smile sport with dspr
    us "Придётся отдать мальчика в бродячий цирк. Там из него вырастят артиста.{w} Кем ты хочешь быть, Макс?{w} Укротителем? {w}Клоуном?{w} Канатоходцем?"
    gg "Акробатом. На голове стоять я уже умею. Осталось научиться по канату ходить - и можно на арену."
    show uv pioneer_laugh with dspr
    uv "Или укротителем."
    th "Не львов конечно. Выбрал, зверя поменьше."
    #(анимация в лицо прилетает струйка воды)
    show us grin sport with dspr
    "Малая брызнула в меня водой."
    us "Или клоуном."
    gg "Ай! Холодная же! Тебе повезло, что у меня ноги болят после вчерашней пробежки."
    show us smile sport with dspr
    us "А то бы что?"
    gg "Догнал бы и наказал."
    us "Как именно наказал?"
    gg "Не знаю…{w} Юля. Как лучше наказывать вредных девчонок?"
    show uv pioneer_smile with dspr
    uv "Дёргать за хвост."
    gg "Не получится, у неё слишком короткие хвостики."
    show us angry sport with dspr
    us "Эй! Не трошь мою причёску. Хочешь кого-то подёргать - дёргай вон! Косатую."
    scene ext_washstand_day
    show uv pioneer_smile at left
    show us angry sport at right
    show sl smile sport
    with dissolve
    sl "Привет, Максим. Привет, Юля.{w} Ульян? Ты снова брызгаешься?"
    show us dontlike sport with dspr
    uv "Чего сразу я? Это всё Мухины… {w} Пришли тут, умываться мешают.{w} У-у-у… вредины."
    show sl laugh sport with dspr
    sl "Конечно. А галстук твой тоже они стащили?"
    show us normal sport with dspr
    us "Галстук я в домике оставила. Специально, чтобы не намочить."


    sl "Ну тогда тебе лучше поспешить в домик.{w} Сюда идут Ольга Дмитриевна и Виолетта Церновна. И они точно не обрадуются твоему внешнему виду."

    show us fear sport
    us "Ой! Что ж ты сразу не сказала?"

    # Ульянка убегает влево
    show us fear sport:
        ease 1 xpos -0.3

    pause(1)
    hide us

    # Смена сцены
    scene ext_washstand_day

    # Слави и Семён (УВ)
    show uv pioneer_normal at left
    show sl laugh sport at center

    # ОД входит справа (позиция left не подойдёт, делаем вручную)
    show mt normal pioneer:
        xalign 1.2
        linear 0.8 xalign 0.85

    # Виола входит справа
    show cs normal casual:
        xalign 1.2
        linear 0.8 xalign 1.15

    th "Похоже тут все собрались."
    th "Кроме тех, кто надо."
    mt "О! А вот и они. Мухины. Мы как раз про вас говорили."
    th "Душа ушла в пятки."
    th "До них дошло, что мы тут незваные гости? И нет никакого дедушки из обкома…"
