    #Space_Song
    $ space_song = "/mods/SkvozUlybku/sound/music/space_song.mp3"
    #КОШКА-ЮЛЯ У ПОДЪЕЗДА
    image cat_night = "/mods/SkvozUlybku/cg/cat_night.png"
    #ДОМ МАКСИМА (ХРУЩЁВКА)
