init:

    $ mods["prologday1"]=u"Сквозь улыбку"
    
    $ gg = Character (u'Максим', color="#ADFF2F", what_color="#ffdd7d")
    
    $ vm = Character (u'Мать', color="#ADFF2F", what_color="#ffdd7d")
    
    $ pr = Character (u'Прохожий', color="#ADFF2F", what_color="#ffdd7d")
    
    
    $ depr = 8
    $ lp = 0;
    $ up = 0;
    $ lp_sl = 0;
    $ lp_un = 0;
    
    #БУДИЛЬНИК
    $ music_up = "/mods/SkvozUlybku/sound/sfx/Radar-1.mp3"   
    #ХЛОПОК ДВЕРИ
    $ dver = "/mods/SkvozUlybku/sound/sfx/hlop.mp3"
    #БГ С ФОНОМ НАСТОЯШЕЙ УЛИЦЫ
    image walk = "/mods/SkvozUlybku/bg/prolog/walk.jpg"
    #ПАДЬЕЗД!
    image padik = "/mods/SkvozUlybku/bg/prolog/pd.jpg"
    #БГ С ФОНОМ НАРИСОВАННОЙ УЛИЦЫ
    image walk2 = "/mods/SkvozUlybku/bg/prolog/IMG_0121.jpg"
    #МАЧОЧЕЛ
    image macho = "/mods/SkvozUlybku/image/sprite/walk/IMG_0124.jpg"
    #ТЯНКАА
    image tyan = "/mods/SkvozUlybku/image/sprite/walk/tyan.jpg"
    #АЛКАХОЛЕК
    image sinyak = "/mods/SkvozUlybku/image/sprite/walk/11.jpg"
    #БУЕРАК ПАРОДИЯ 
    $ doomer1 = "/mods/SkvozUlybku/sound/music/prologsong1.mp3"
    #БУЕРАК НАСТОЯЩИЙ
