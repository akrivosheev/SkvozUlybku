    #ВНУТРИ АВТОБУСА ГОРОД
    image int_liaz_city = "/mods/SkvozUlybku/bg/prolog/int_liaz.jpg"
    #ВНУТРИ АВТОБУСА ГОРОД ЭМБИЕНС
